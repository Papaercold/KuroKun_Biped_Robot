<?xml version="1.0"?>
<!--
  KuroKun Biped Robot - URDF (Simplified Box Model)
  ================================================
  Coordinate convention:
    X = forward (robot facing direction)
    Y = left
    Z = up

  Kinematic chain (per leg):
    base_link
      └─[hip_roll,  axis=X] ─ hip_roll_link   (45.22×24.72×36.3 mm, long axis along X = inner/medial)
          └─[hip_pitch, axis=Y] ─ hip_pitch_link (motor 45.22×24.72×36.3 mm, 48 g)
              └─[fixed]  ─ thigh_link  (37×25×35 mm, 10 g)
              └─[knee,      axis=Y] ─ knee_link  (motor 45.22×24.72×36.3 mm, 48 g)
                  └─[fixed]  ─ shank_link  (37×25×35 mm, 10 g)
                      └─[ankle,  axis=Y] ─ ankle_link (45.22×24.72×36.3 mm)
                      └─[foot_fixed] ─ foot_link  (80×45×10 mm)

  Hip assembly (L-shape from top / XY view):
    - hip_pitch (Y-axis): FRONT motor, long axis along X (45.22 mm), at x=0, y=±0.050
    - hip_roll  (X-axis): REAR  motor, rotated 90° around Z, long axis along Y (45.22 mm)
    - Both tops flush (z=−0.030); OUTER faces aligned at y=±0.06236 — forms L corner.
    - L opens INWARD (toward robot center). hip_roll extends inward.
    - Touching along X: ΔX(centers) = 45.22/2 + 24.72/2 = 22.61 + 12.36 = 34.97 mm
    - hip_pitch joint (base frame) : x= 0.000,   y=±0.050,   z=−0.030
    - hip_roll  joint (base frame) : x=−0.03497, y=±0.03975, z=−0.030
      (y_hr = leg_outer − hip_roll_half_Y = 0.06236 − 0.02261 = 0.03975)
    - hip_pitch joint in hip_roll_link: LEFT  xyz=(+0.03497, +0.01025, 0)
                                        RIGHT xyz=(+0.03497, −0.01025, 0)
    - Touch at x=−0.02261 (hip_pitch rear face = hip_roll front face ✓)
    - Inter-leg inner clearance: 2×0.01714 = 34.28 mm ✓

  Mass assumptions:
    Each motor link  : 48 g  (LX-16A spec, Hiwonder official)
    Foot link        : 10 g  (3D-printed PLA, light)
    base_link        : 250 g (RPi 4B ~46 g + PSU ~175 g + structure ~30 g)

  LX-16A official dimensions (Hiwonder): 45.22 × 24.72 × 36.3 mm
  Inertia calculated analytically for uniform solid box  I = m/12*(a²+b²).

  Inertia tables (m = 0.048 kg):
    hip_roll_link  box X=24.72 Y=45.22 Z=36.3 mm (rotated 90° around Z):
      Ixx = m/12*(Y²+Z²) = 1.345e-5
      Iyy = m/12*(X²+Z²) = 7.72e-6
      Izz = m/12*(X²+Y²) = 1.062e-5
    hip_pitch_link box X=45.22 Y=24.72 Z=36.3 mm:
      Ixx = m/12*(Y²+Z²) = 7.72e-6
      Iyy = m/12*(X²+Z²) = 1.345e-5
      Izz = m/12*(X²+Y²) = 1.062e-5
-->
<robot name="kurokun">

  <!-- ========== MATERIALS (named — for RViz2; Isaac Sim uses inline colors below) ========== -->
  <material name="body">
    <color rgba="0.40 0.55 0.70 1.0"/>
  </material>
  <material name="motor">
    <color rgba="0.22 0.22 0.24 1.0"/>
  </material>
  <material name="motor_roll">
    <color rgba="0.80 0.42 0.10 1.0"/>
  </material>
  <material name="connector">
    <color rgba="0.62 0.64 0.68 1.0"/>
  </material>
  <material name="foot">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="head">
    <color rgba="0.90 0.85 0.80 1.0"/>
  </material>

  <!-- ========== BASE LINK ========== -->
  <!-- URDF root frame (required). No visual. Mass ≈ 1 g (negligible connector). -->
  <!-- All body mass (RPi + PSU + electronics = 250 g) lives in head_link.        -->
  <!-- Ixx = 0.001/12*(0.100²+0.060²) = 1.133e-6                                 -->
  <!-- Iyy = 0.001/12*(0.120²+0.060²) = 1.500e-6                                 -->
  <!-- Izz = 0.001/12*(0.120²+0.100²) = 2.033e-6                                 -->
  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.133e-6" ixy="0" ixz="0"
               iyy="1.500e-6" iyz="0"
               izz="2.033e-6"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.120 0.100 0.060"/></geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!--                        LEFT LEG                              -->
  <!-- ============================================================ -->

  <!-- LEFT HIP ROLL (axis = X) -->
  <!-- Rear motor, rotated 90° around Z (long axis now along Y = 45.22 mm). -->
  <!-- Joint at x=−0.03497, y=+0.03975, z=−0.030.                          -->
  <!-- Outer face (y=0.06236) aligned with outer face of hip_pitch (L corner).-->
  <!-- hip_roll extends INWARD (toward robot center). -->
  <joint name="left_hip_roll" type="revolute">
    <parent link="base_link"/>
    <child  link="left_hip_roll_link"/>
    <origin xyz="-0.03497 0.03975 -0.030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.524" upper="0.524" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- hip_roll motor box: X=24.72 mm, Y=45.22 mm, Z=36.3 mm (rotated 90° around Z) -->
  <!-- Ixx=1.345e-5  Iyy=7.72e-6  Izz=1.062e-5                                      -->
  <link name="left_hip_roll_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="1.345e-5" ixy="0" ixz="0"
               iyy="7.72e-6" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.02472 0.04522 0.0363"/></geometry>
      <material name="motor_roll"><color rgba="0.80 0.42 0.10 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.02472 0.04522 0.0363"/></geometry>
    </collision>
  </link>

  <!-- LEFT HIP PITCH (axis = Y) -->
  <!-- Front motor. Offset +34.97 mm in X (forward), +10.25 mm in Y (outward). -->
  <!-- Joint in base frame: (0, +0.050, −0.030). Tops flush with hip_roll.      -->
  <!-- Same orientation as knee/ankle (45.22 mm along X).                       -->
  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_roll_link"/>
    <child  link="left_hip_pitch_link"/>
    <origin xyz="0.03497 0.01025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.785" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- hip_pitch motor box: X=45.22 mm, Y=24.72 mm, Z=36.3 mm (same as knee/ankle) -->
  <!-- Ixx=7.72e-6  Iyy=1.345e-5  Izz=1.062e-5                                    -->
  <link name="left_hip_pitch_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="7.72e-6" ixy="0" ixz="0"
               iyy="1.345e-5" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <!-- motor box -->
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
      <material name="motor"><color rgba="0.22 0.22 0.24 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
    </collision>
  </link>

  <!-- LEFT THIGH CONNECTOR (fixed, 37×25×35 mm, 10 g) -->
  <!-- CoM at z=−0.0175 (center of 35 mm connector).    -->
  <!-- Ixx=1.542e-6  Iyy=2.162e-6  Izz=1.662e-6         -->
  <joint name="left_thigh_joint" type="fixed">
    <parent link="left_hip_pitch_link"/>
    <child  link="left_thigh_link"/>
    <origin xyz="0 0 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="left_thigh_link">
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <inertia ixx="1.542e-6" ixy="0" ixz="0"
               iyy="2.162e-6" iyz="0"
               izz="1.662e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
      <material name="connector"><color rgba="0.62 0.64 0.68 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
    </collision>
  </link>

  <!-- LEFT KNEE (axis = Y) -->
  <!-- joint offset = thigh connector length (0.035) -->
  <joint name="left_knee" type="revolute">
    <parent link="left_thigh_link"/>
    <child  link="left_knee_link"/>
    <origin xyz="0 0 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.571" upper="0.0" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- knee motor box: 45.22×24.72×36.3 mm, 48 g -->
  <link name="left_knee_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="7.72e-6" ixy="0" ixz="0"
               iyy="1.345e-5" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <!-- motor box -->
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
      <material name="motor"><color rgba="0.22 0.22 0.24 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
    </collision>
  </link>

  <!-- LEFT SHANK CONNECTOR (fixed, 37×25×35 mm, 10 g) -->
  <!-- Ixx=1.542e-6  Iyy=2.162e-6  Izz=1.662e-6          -->
  <joint name="left_shank_joint" type="fixed">
    <parent link="left_knee_link"/>
    <child  link="left_shank_link"/>
    <origin xyz="0 0 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="left_shank_link">
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <inertia ixx="1.542e-6" ixy="0" ixz="0"
               iyy="2.162e-6" iyz="0"
               izz="1.662e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
      <material name="connector"><color rgba="0.62 0.64 0.68 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
    </collision>
  </link>

  <!-- LEFT ANKLE (axis = Y) -->
  <!-- joint offset = shank connector length (0.035) -->
  <joint name="left_ankle" type="revolute">
    <parent link="left_shank_link"/>
    <child  link="left_ankle_link"/>
    <origin xyz="0 0 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.524" upper="0.524" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- Ankle motor box: 45.22×24.72×36.3 mm, mass 48 g -->
  <link name="left_ankle_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="7.72e-6" ixy="0" ixz="0"
               iyy="1.345e-5" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
      <material name="motor"><color rgba="0.22 0.22 0.24 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
    </collision>
  </link>

  <!-- LEFT FOOT (fixed) -->
  <joint name="left_ankle_to_foot" type="fixed">
    <parent link="left_ankle_link"/>
    <child  link="left_foot_link"/>
    <origin xyz="0 0 -0.0363" rpy="0 0 0"/>
  </joint>

  <!-- Foot box: 80×45×10 mm, mass 10 g, centred on ankle axis (±40mm fore/aft) -->
  <!-- Ixx = 0.010/12*(0.045²+0.010²) = 1.771e-6 -->
  <!-- Iyy = 0.010/12*(0.080²+0.010²) = 5.417e-6 -->
  <!-- Izz = 0.010/12*(0.080²+0.045²) = 7.021e-6 -->
  <link name="left_foot_link">
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <inertia ixx="1.771e-6" ixy="0" ixz="0"
               iyy="5.417e-6" iyz="0"
               izz="7.021e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.080 0.045 0.010"/></geometry>
      <material name="foot"><color rgba="0.12 0.12 0.14 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.080 0.045 0.010"/></geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!--                       RIGHT LEG                              -->
  <!-- ============================================================ -->

  <!-- RIGHT HIP ROLL (axis = X) -->
  <!-- Rear motor, rotated 90° around Z (long axis now along Y = 45.22 mm). -->
  <!-- Joint at x=−0.03497, y=−0.03975, z=−0.030.                          -->
  <!-- Outer face (y=−0.06236) aligned with outer face of hip_pitch (L corner).-->
  <!-- hip_roll extends INWARD (toward robot center). -->
  <joint name="right_hip_roll" type="revolute">
    <parent link="base_link"/>
    <child  link="right_hip_roll_link"/>
    <origin xyz="-0.03497 -0.03975 -0.030" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.524" upper="0.524" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- hip_roll motor box: X=24.72 mm, Y=45.22 mm, Z=36.3 mm (rotated 90° around Z) -->
  <!-- Ixx=1.345e-5  Iyy=7.72e-6  Izz=1.062e-5                                      -->
  <link name="right_hip_roll_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="1.345e-5" ixy="0" ixz="0"
               iyy="7.72e-6" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.02472 0.04522 0.0363"/></geometry>
      <material name="motor_roll"><color rgba="0.80 0.42 0.10 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.02472 0.04522 0.0363"/></geometry>
    </collision>
  </link>

  <!-- RIGHT HIP PITCH (axis = Y) -->
  <!-- Front motor. Offset +34.97 mm in X (forward), −10.25 mm in Y (outward). -->
  <!-- Joint in base frame: (0, −0.050, −0.030). Same orientation as knee.      -->
  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child  link="right_hip_pitch_link"/>
    <origin xyz="0.03497 -0.01025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.785" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- hip_pitch motor box: X=45.22 mm, Y=24.72 mm, Z=36.3 mm (same as knee/ankle) -->
  <!-- Ixx=7.72e-6  Iyy=1.345e-5  Izz=1.062e-5                                    -->
  <link name="right_hip_pitch_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="7.72e-6" ixy="0" ixz="0"
               iyy="1.345e-5" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <!-- motor box -->
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
      <material name="motor"><color rgba="0.22 0.22 0.24 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
    </collision>
  </link>

  <!-- RIGHT THIGH CONNECTOR (fixed, 37×25×35 mm, 10 g) -->
  <!-- Ixx=1.542e-6  Iyy=2.162e-6  Izz=1.662e-6           -->
  <joint name="right_thigh_joint" type="fixed">
    <parent link="right_hip_pitch_link"/>
    <child  link="right_thigh_link"/>
    <origin xyz="0 0 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="right_thigh_link">
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <inertia ixx="1.542e-6" ixy="0" ixz="0"
               iyy="2.162e-6" iyz="0"
               izz="1.662e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
      <material name="connector"><color rgba="0.62 0.64 0.68 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
    </collision>
  </link>

  <!-- RIGHT KNEE (axis = Y) -->
  <!-- joint offset = thigh connector length (0.035) -->
  <joint name="right_knee" type="revolute">
    <parent link="right_thigh_link"/>
    <child  link="right_knee_link"/>
    <origin xyz="0 0 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.571" upper="0.0" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- knee motor box: 45.22×24.72×36.3 mm, 48 g -->
  <link name="right_knee_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="7.72e-6" ixy="0" ixz="0"
               iyy="1.345e-5" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <!-- motor box -->
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
      <material name="motor"><color rgba="0.22 0.22 0.24 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
    </collision>
  </link>

  <!-- RIGHT SHANK CONNECTOR (fixed, 37×25×35 mm, 10 g) -->
  <!-- Ixx=1.542e-6  Iyy=2.162e-6  Izz=1.662e-6           -->
  <joint name="right_shank_joint" type="fixed">
    <parent link="right_knee_link"/>
    <child  link="right_shank_link"/>
    <origin xyz="0 0 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="right_shank_link">
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <inertia ixx="1.542e-6" ixy="0" ixz="0"
               iyy="2.162e-6" iyz="0"
               izz="1.662e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
      <material name="connector"><color rgba="0.62 0.64 0.68 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><box size="0.037 0.025 0.035"/></geometry>
    </collision>
  </link>

  <!-- RIGHT ANKLE (axis = Y) -->
  <!-- joint offset = shank connector length (0.035) -->
  <joint name="right_ankle" type="revolute">
    <parent link="right_shank_link"/>
    <child  link="right_ankle_link"/>
    <origin xyz="0 0 -0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.524" upper="0.524" effort="1.5" velocity="6.1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <link name="right_ankle_link">
    <inertial>
      <mass value="0.048"/>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <inertia ixx="7.72e-6" ixy="0" ixz="0"
               iyy="1.345e-5" iyz="0"
               izz="1.062e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
      <material name="motor"><color rgba="0.22 0.22 0.24 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01815" rpy="0 0 0"/>
      <geometry><box size="0.04522 0.02472 0.0363"/></geometry>
    </collision>
  </link>

  <!-- RIGHT FOOT (fixed) -->
  <joint name="right_ankle_to_foot" type="fixed">
    <parent link="right_ankle_link"/>
    <child  link="right_foot_link"/>
    <origin xyz="0 0 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="right_foot_link">
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <inertia ixx="1.771e-6" ixy="0" ixz="0"
               iyy="5.417e-6" iyz="0"
               izz="7.021e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.080 0.045 0.010"/></geometry>
      <material name="foot"><color rgba="0.12 0.12 0.14 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.080 0.045 0.010"/></geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!--                          HEAD                                -->
  <!-- ============================================================ -->
  <!-- Y = 75.28 mm : spans hip_pitch inner faces (y=±0.03764m, same as before).    -->
  <!-- X = 65 mm    : rear flush with hip assembly (x=−0.02261m),                   -->
  <!--                front protrudes 19.78mm beyond hip_pitch front (x=+0.04239m). -->
  <!-- Z = 42 mm    : top 6mm above motor tops (z=−0.024m), bottom z=−0.066m.       -->
  <!-- Joint centre (base frame) = x=+0.010, z=−0.045 (box centroid).               -->
  <!-- CoM at physical centre (0,0,0). mass=250g (RPi+PSU+electronics).             -->
  <!-- Ixx=1.548e-4  Iyy=1.248e-4  Izz=2.061e-4  (250g, 65×75.28×42mm)            -->
  <joint name="head_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="head_link"/>
    <origin xyz="0.010 0 -0.045" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <inertial>
      <mass value="0.250"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.548e-4" ixy="0" ixz="0"
               iyy="1.248e-4" iyz="0"
               izz="2.061e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.065 0.07528 0.042"/></geometry>
      <material name="head"><color rgba="0.90 0.85 0.80 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.065 0.07528 0.042"/></geometry>
    </collision>
  </link>

</robot>
